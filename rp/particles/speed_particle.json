{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:speed_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/speed_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.2, 0],
				"radius": 0.5,
				"surface_only": true,
				"direction": [1, 2, 1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2.2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-100, 100)",
				"rotation_rate": "math.random(215, 420)"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(math.cos(variable.particle_age*200))*16 + math.random_integer(-2, 2)", "1.9 + math.random_integer(-3, 7)", "(math.cos(variable.particle_age*200))*16 + math.random_integer(-2, 2) "],
				"linear_drag_coefficient": 9
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.11 + variable.particle_random_1 * 0.05) - v.particle_age*0.03", "(0.11 + variable.particle_random_1 * 0.05) - v.particle_age*0.03"],
				"facing_camera_mode": "rotate_y",
				"uv": {
					"texture_width": 10,
					"texture_height": 50,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [10, 10],
						"step_UV": [0, 10],
						"frames_per_second": 5,
						"max_frame": 5,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFE1F8FF",
						"0.69": "#ADCEFFFD",
						"0.97": "#00E4FFFF"
					}
				}
			}
		}
	}
}
