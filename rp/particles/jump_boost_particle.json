{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:jump_boost_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/jump_boost_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 25,
				"max_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.55
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.5, 0],
				"radius": 0.8,
				"surface_only": true,
				"direction": ["math.random(-0.2, 0.2)", "math.random(1, 5)", "math.random(-0.2, 0.2)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.6
			},
			"minecraft:particle_initial_speed": "math.random(1.5, 3)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-1, 1)", "math.random(-1, 3)", "math.random(-1, 1)"],
				"linear_drag_coefficient": 2.7
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.07 + variable.particle_random_1*0.11 - v.particle_lifetime*0.03", "0.13 + variable.particle_random_1*0.11 - v.particle_lifetime*0.03"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 80,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 6,
						"max_frame": 5,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.59": "#ffffffff",
						"1.0": "#1AFFFFFF"
					}
				}
			}
		}
	}
}