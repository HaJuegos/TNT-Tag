{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:wing_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/items/angel_feather"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 32
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-2, 2)", "math.random(-3, 3)", "math.random(-2, 2)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.7, 2.3)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-100, 100)",
				"rotation_rate": "math.random(215, 420)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-3, 4)", "math.random(-4, 2)", "math.random(-2, 4)"],
				"linear_drag_coefficient": 2.1,
				"rotation_acceleration": "math.random(-0.5, 2)",
				"rotation_drag_coefficient": "math.random(-0.5, 2)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.07 + variable.particle_random_1 * 0.12", "0.07 + variable.particle_random_1 * 0.12"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 48,
					"flipbook": {
						"base_UV": [0, "0 + math.round(v.particle_random_1) * 16 + math.round(v.particle_random_2) * 16"],
						"size_UV": [16, 16],
						"step_UV": [0, 0],
						"max_frame": 3
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#F0FFFFFF",
						"0.59": "#D6EACBB5",
						"1.0": "#0FFFFFFF"
					}
				}
			}
		}
	}
}