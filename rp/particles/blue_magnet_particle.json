{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:blue_magnet_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/magnet_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 50,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.1, 0],
				"radius": 0.7,
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.6, 2.2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-100, 100)",
				"rotation_rate": "math.random(215, 420)"
			},
			"minecraft:particle_initial_speed": 0.9,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": "0.2 + v.particle_age * 0.9"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.06 + math.clamp(0.06 + variable.particle_random_1*0.08 - v.particle_age*0.05, 0.1, 1)", "math.clamp(0.06 + variable.particle_random_1*0.08 - v.particle_age*0.05, 0.1, 1)"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 11,
					"texture_height": 55,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [11, 11],
						"step_UV": [0, 11],
						"frames_per_second": 5,
						"max_frame": 5,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFB4D2FF",
						"0.51": "#C75868FF",
						"1.0": "#3B000261"
					}
				}
			}
		}
	}
}