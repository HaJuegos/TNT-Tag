{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:weight_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/weight_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 25,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.4
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, -1.5, 0],
				"half_dimensions": [0.7, 0.2, 0.7]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2.4, 2.7)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "(v.particle_age * -2.8) + (v.particle_age * -4.8)", 0],
				"linear_drag_coefficient": 1.9
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.clamp((math.clamp((0.1 + v.particle_age*0.2), 0.15, 0.4) - math.clamp(v.particle_age*0.8, 0, v.particle_age*0.15)), 0.01, 4)", "math.clamp((math.clamp((0.1 + v.particle_age*0.2), 0.15, 0.4) - math.clamp(v.particle_age*0.8, 0, v.particle_age*0.15)), 0.01, 4)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 12,
					"texture_height": 36,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [12, 12],
						"step_UV": [0, 12],
						"frames_per_second": 2,
						"max_frame": 3
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 0.27,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.02": "#FFD8D8D8",
						"0.53": "#C7AAAAAA",
						"1.0": "#24FFFFFF"
					}
				}
			}
		}
	}
}