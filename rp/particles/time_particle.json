{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "astral:time_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/time_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 22
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.6,
				"surface_only": true,
				"direction": [0, "v.emitter_age * math.random(0.1, 0.2)", 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.4, 1.7)"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": "math.round(v.particle_random_1) * 1000"
			},
			"minecraft:particle_initial_speed": 1.4,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(0.1, 0.2)", 0],
				"linear_drag_coefficient": 1.8,
				"rotation_acceleration": "math.round(v.particle_random_1) * 600 ",
				"rotation_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.clamp(((0.3 - (variable.particle_random_1 * 0.12) - (variable.particle_random_2 * 0.1)) - variable.particle_age*0.11), 0.02, 3)", "math.clamp(((0.3 - (variable.particle_random_1 * 0.12) - (variable.particle_random_2 * 0.1)) - variable.particle_age*0.11), 0.02, 3)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 10,
					"texture_height": 30,
					"flipbook": {
						"base_UV": [0, "0 + math.round(v.particle_random_1) * 10 + math.round(v.particle_random_2) * 20"],
						"size_UV": [10, 10],
						"step_UV": [0, 0]
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "1.1 + (v.particle_age / v.particle_lifetime - (math.round(v.particle_random_1) * 1.1) - (math.round(v.particle_random_2) * 1.1))",
					"gradient": {
						"0.0": "#FF11AE4F",
						"0.5": "#C70F7601",
						"1.0": "#2B8CEBFF",
						"1.5": "#ffffffff",
						"2.0": "#0FFFFFFF"
					}
				}
			}
		}
	}
}