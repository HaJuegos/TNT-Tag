{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.power_ups.particles": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "wings": "q.variant == 7"
                        },
                        {
                            "jump": "q.variant == 5"
                        },
                        {
                            "speed": "q.variant == 6"
                        },
                        {
                            "blind": "q.variant == 2"
                        }
                    ]
                },
                "wings": {
                    "animations": [ "wings" ],
                    "transitions": [
                        {
                            "default": "q.any_animation_finished && q.variant != 7"
                        }
                    ]
                },
                "speed": {
                    "animations": [ "particle_speed" ],
                    "transitions": [
                        {
                            "default": "q.any_animation_finished && q.variant != 6"
                        }
                    ]
                },
                "jump": {
                    "animations": [ "particle_jump" ],
                    "transitions": [
                        {
                            "default": "q.any_animation_finished && q.variant != 5"
                        }
                    ]
                },
                "blind": {
                    "animations": [ "particle_blind" ],
                    "transitions": [
                        {
                            "default": "q.any_animation_finished && q.variant != 2"
                        }
                    ]
                }
            }
        }
    }
}
