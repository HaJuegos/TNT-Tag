{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.custom_npcs": {
			"arrays": {
				"textures": {
					"Array.skins": ["Texture.royer", "Texture.tenier", "Texture.ha", "Texture.memo", "Texture.void"]
				},
				"geometries": {
					"Array.geos": ["Geometry.alex", "Geometry.alex", "Geometry.alex", "Geometry.alex", "Geometry.default"]
				}
			},
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"geometry": "Array.geos[q.variant]",
			"textures": ["Array.skins[q.variant]"],
			"ignore_lighting": true
		}
	}
}
