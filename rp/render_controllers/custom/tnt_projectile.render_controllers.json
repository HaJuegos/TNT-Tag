{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.tnt_projectile": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "(query.anim_time > 0.35) ? ((math.mod(query.anim_time, 0.7) < 0.35) ? Texture.white : Texture.default) : Texture.default"
            ],
            "filter_lighting": true,
            "is_hurt_color": {
                "r": 0,
                "g": 0,
                "b": 0,
                "a": 0
            },
            "on_fire_color": {
                "r": 0,
                "g": 0,
                "b": 0,
                "a": 0
            }
        }
    }
}
