{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.player.in_red": {
			"geometry": "Geometry.innet",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [ "Texture.net" ],
			"is_hurt_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": 0
			},
			"on_fire_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": 0
			}
		},
		"controller.render.player.third_person_glow": {
			"geometry": "Geometry.glow",
			"materials": [
				{
					"*": "Material.glow"
				}
			],
			"textures": [ "Texture.glow" ],
			"ignore_lighting": true,
			"overlay_color": {
				"r": 0.937,
				"g": 0.816,
				"b": 0.231,
				"a": 1
			},
			"is_hurt_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": 0
			},
			"on_fire_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": 0
			}
		},
		"controller.render.player.third_person": {
			"geometry": "(q.is_tamed) ? Geometry.remove : Geometry.default",
			"materials": [
				{
					"*": "(q.is_tamed) ? Material.glow_base : Material.default"
				}
			],
			"textures": [ "Texture.default" ],
			"overlay_color": {
				"r": "q.is_pregnant ? (math.floor(math.mod(math.max(0, q.life_time - variable.last_pregnant_change_time), 0.25) * 7) * 0.9 + 0.35) * math.clamp(math.max(0, q.life_time - variable.last_pregnant_change_time) / 1.65, 0.2, 1.0) : 0.0",
				"g": "q.is_pregnant ? 0.0 : 0.0",
				"b": "q.is_pregnant ? 0.0 : 0.0",
				"a": "q.is_pregnant ? (math.floor(math.mod(math.max(0, q.life_time - variable.last_pregnant_change_time), 0.25) * 7) * 0.5 + 0.35) * math.clamp(math.max(0, q.life_time - variable.last_pregnant_change_time) / 1.65, 0.1, 1.0) : 0.0"
			},
			"part_visibility": [
				{
					"*": "!q.is_tamed"
				},
				{
					"cape": "!q.is_tamed"
				},
				{
					"helmet": "variable.helmet_layer_visible"
				},
				{
					"leftLegging": "variable.leg_layer_visible"
				},
				{
					"rightLegging": "variable.leg_layer_visible"
				},
				{
					"leftBoot": "variable.boot_layer_visible"
				},
				{
					"rightBoot": "variable.boot_layer_visible"
				},
				{
					"leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
				},
				{
					"rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
				},
				{
					"bodyArmor": "variable.chest_layer_visible && !query.has_cape"
				},
				{
					"leftArmArmor": "variable.chest_layer_visible && !query.has_cape"
				},
				{
					"rightArmArmor": "variable.chest_layer_visible && !query.has_cape"
				},
				{
					"belt": "variable.chest_layer_visible && variable.leg_layer_visible"
				}
			]
		}
	}
}
