{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "ha:power_ups",
            "materials": {
                "default": "entity_alphatest",
                "blend": "entity_alphablend",
                "overlay": "entity_emissive_alpha_one_sided"
            },
            "geometry": {
                "coin": "geometry.powerup.coin",
                "blindness": "geometry.powerup.blindness",
                "boots": "geometry.powerup.boots",
                "wings": "geometry.powerup.wings",
                "two_dimension": "geometry.powerup.two_dimension",
                "elytra": "geometry.powerup.elytra",
                "gun": "geometry.powerup.gun",
                "companion_cube": "geometry.powerup.companion_cube",

                "slowness": "geometry.powerup.slowness",
                "clock_add": "geometry.powerup.clock_add",
                "broken_clock": "geometry.powerup.clock_broken",
                "magnet": "geometry.powerup.magnet",

                // Bow geos
                "bow.quiver_overlay": "geometry.powerup.bow_arrow.quiver_overlay",
                "bow.bow_mesh": "geometry.powerup.bow_arrow.bow_mesh",
                "bow.arrow_mesh": "geometry.powerup.bow_arrow.arrows_mesh",

                // Invisility geos
                "invi.full_body": "geometry.powerup.invisibility.person",
                "invi.mirror": "geometry.powerup.invisibility.mirror"
            },
            "textures": {
                "nothing": "textures/entity/power_ups/none",
                "coin": "textures/entity/power_ups/coin",
                "blindness": "textures/entity/power_ups/blindness",
                "invi": "textures/entity/power_ups/invi",
                "bow": "textures/entity/power_ups/bow_and_quiver",
                "jump": "textures/entity/power_ups/jump",
                "speed": "textures/entity/power_ups/speed",

                "wing": "textures/entity/power_ups/wings_boost",
                "clock": "textures/entity/power_ups/clock_add",
                "slow": "textures/entity/power_ups/slowness_debuff",

                "elytra": "textures/models/armor/elytra",
                "gun": "textures/models/weapon/net_gun",
                "companion_cube": "textures/entity/power_ups/companion_cube",

                "broken_clock": "textures/entity/power_ups/clock_remove",
                "magnet": "textures/entity/power_ups/magnet_buff",

                // Bow extras
                "bow_mesh": "textures/items/bow_standby",
                "arrow_mesh": "textures/items/arrow"
            },
            "scripts": {
                "animate": [
                    "idle",
                    "idle_position",
                    "controller_particles",
                    {
                        "scale": "q.variant == 1 || q.variant == 5 || q.variant == 6 || q.variant == 8 || q.variant == 9 || q.variant == 13 || q.variant == 14"
                    },
                    {
                        "scale_gun": "q.variant == 11"
                    }
                ]
            },
            "animations": {
                "controller_particles": "controller.animation.power_ups.particles",
                "particle_jump": "animation.powerup_particle.jump",
                "particle_blind": "animation.powerup_particle.blindess",
                "particle_speed": "animation.powerup_particle.speed",

                "idle": "animation.boost.idle",
                "idle_position": "animation.boost.idle_position",
                "scale": "animation.boost.scale",
                "wings": "animation.boost.wings",
                "scale_gun": "animation.boost.scale_gun"
            },
            "render_controllers": [
                "controller.render.power_ups",

                // Bow extras
                { "controller.render.power_up.bow_extras.bow_mesh": "q.variant == 4" },
                { "controller.render.power_up.bow_extras.arrow_mesh": "q.variant == 4" },

                // Invi extras
                { "controller.render.power_up.invi_extras.mirror": "q.variant == 3" }
            ],
            "spawn_egg": {
                "texture": "spawn_generator"
            },
            "particle_effects": {
                "wing": "astral:wing_particle",
                "speed": "astral:speed_particle",
                "jump": "astral:jump_boost_particle",
                "blind": "astral:blindness_smoke",
				"blind_eye": "astral:blindness_particle",
				"weight_particle": "astral:weight_particle",
				"blue_magnet_particle": "astral:blue_magnet_particle",
				"red_magnet_particle": "astral:red_magnet_particle",
				"diana_particle": "astral:diana_particle",
				"lblue_boost_particle": "astral:lblue_boost_particle",
				"pink_boost_particle": "astral:pink_boost_particle",
				"cyan_boost_particle": "astral:cyan_boost_particle",
				"yellow_boost_particle": "astral:yellow_boost_particle",
				"time_particle": "astral:time_particle",
				"broken_time_particle": "astral:broken_time_particle"
            }
        }
    }
}
