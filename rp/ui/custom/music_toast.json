{
    "namespace": "toast_music_screen",

    // Playbox atlas
    "playbox_anim": {
        "anim_type": "flip_book",
        "initial_uv": [ 0, 0 ],
        "frame_count": 72,
        "frame_step": 151,
        "fps": 20,
        "reversible": false,
        "easing": "linear"
    },

    // Panels
    "playing_music1": {
        "type": "panel",
        "offset": [ 0, 0 ],
        "anims": [ "@toast_music_screen.anim1" ],
        "controls": [
            {
                "title": {
                    "type": "label",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "text": "ui.title_music1",
                    "font_size": "normal",
                    "font_scale_factor": 0.8,
                    "localize": true,
                    "layer": 101,
                    "offset": [ 33, 9.8 ],
                    "text_alignment": "left"
                }
            },
            {
                "subtitle": {
                    "type": "label",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "text": "ui.subtitle_music1",
                    "font_scale_factor": 0.6,
                    "offset": [ 34, 21.5 ],
                    "font_size": "normal",
                    "localize": true,
                    "text_alignment": "left",
                    "layer": 101
                }
            },
            {
                "playbox": {
                    "type": "image",
                    "texture": "textures/ui/custom/map_icons/musicbox",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [ "1%c + 26px", "1%c + 26px" ],
                    "offset": [ 7.5, 5 ],
                    "layer": 101,
                    "uv_size": [ 151, 151 ],
                    "uv": "@toast_music_screen.playbox_anim",
                    "disable_anim_fast_forward": true
                }
            },
            {
                "border": {
                    "type": "image",
                    "texture": "textures/ui/greyBorder",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [ "1%c + 160px", "1%c + 32px" ],
                    "offset": [ 3, 3 ],
                    "layer": 100
                }
            }
        ],
        "bindings": [
            {
                "binding_name": "#hud_subtitle_text_string",
                "binding_name_override": "#text"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#text = (#text - 'l.asobu') + 'l.asobu' or #text = (#text - 'm.asobu.showtnton') + 'm.asobu.showtnton' or #text = (#text - 'm.asobu.showtntoff') + 'm.asobu.showtntoff')",
                "target_property_name": "#visible"
            }
        ]
    },
