{
    "format_version": "1.21.40",
    "minecraft:entity": {
        "description": {
            "identifier": "ha:tnt_projectile_entity",
            "runtime_identifier": "minecraft:ender_pearl",
            "spawn_category": "misc",
            "is_experimental": false,
            "is_spawnable": false,
            "is_summonable": true
        },
        "component_groups": {
            "ha:projectile_mode": {
                "minecraft:projectile": {
                    "on_hit": {
                        "impact_damage": {
                            "damage": 0,
                            "knockback": true,
                            "destroy_on_hit": false,
                            "should_bounce": false
                        },
                        "arrow_effect": { },
                        "stick_in_ground": {
                            "shake_time": 0
                        },
                        "definition_event": {
                            "affect_projectile": true,
                            "event_trigger": {
                                "event": "ha:start_timer_despawn",
                                "target": "self"
                            }
                        }
                    },
                    "anchor": 1,
                    "gravity": 0.15,
                    "power": 4,
                    "angle_offset": 0,
                    "offset": [ 0, 0.25, 0 ],
                    "reflect_on_hurt": true,
                    "should_bounce": false,
                    "multiple_targets": false,
                    "is_dangerous": true,
                    "stop_on_hurt": true,
                    "uncertainty_base": 0,
                    "uncertainty_multiplier": 0,
                    "ignored_entities": [
                        "boat",
                        "chest_boat",
                        "minecart",
                        "ha:power_ups",
                        "ha:custom_npc"
                    ]
                }
            },
            "ha:timer_despawn": {
                "minecraft:timer": {
                    "time": [ 5, 5 ],
                    "looping": true,
                    "time_down_event": {
                        "event": "ha:despawn",
                        "target": "self"
                    }
                }
            },
            "ha:despawn": {
                "minecraft:instant_despawn": { }
            }
        },
        "components": {
            "minecraft:transient": { },
            "minecraft:knockback_resistance": {
                "value": 99999
            },
            "minecraft:health": {
                "value": 2,
                "max": 2,
                "min": 2
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "all",
                        "deals_damage": "no"
                    }
                ]
            },
            "minecraft:collision_box": {
                "height": 1,
                "width": 0.45
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:cannot_be_attacked": { },
            "minecraft:floats_in_liquid": { },
            "minecraft:friction_modifier": {
                "value": 0.5
            },
            "minecraft:persistent": { },
            "minecraft:type_family": {
                "family": [ "tnt_projectile", "inanimate", "mob" ]
            },
            "minecraft:tick_world": {
                "never_despawn": true,
                "radius": 4
            },
            "minecraft:physics": { },
            "minecraft:dimension_bound": { },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {
                "default_values": {
                    "max_optimized_distance": 80.0,
                    "max_dropped_ticks": 7,
                    "use_motion_prediction_hints": true
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "ha:projectile_mode"
                    ]
                }
            },
            "ha:start_timer_despawn": {
                "add": {
                    "component_groups": [
                        "ha:timer_despawn"
                    ]
                }
            },
            "ha:despawn": {
                "remove": {
                    "component_groups": [
                        "ha:timer_despawn"
                    ]
                },
                "add": {
                    "component_groups": [
                        "ha:despawn"
                    ]
                }
            }
        }
    }
}
