{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.player.detection": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "isAttack": "variable.attack_time > 0.0f && q.is_pregnant"
                        }
                    ]
                },
                "isAttack": {
                    "on_entry": [
                        "/scriptevent ha:is_attack"
                    ],
                    "transitions": [
                        {
                            "default": "variable.attack_time <= 0.0f"
                        }
                    ]
                }
            }
        }
    }
}
